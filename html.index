                    'Mengistirahatkan seluruh tubuh selama satu bulan'
                ],
                jawabanBenar: 1,
                pembahasan: 'Kompres dingin (Ice) menyempitkan pembuluh darah lokal (vasokonstriksi) sehingga efektif meredakan nyeri dan mencegah pembengkakan berlebih pada 24–48 jam pertama.'
            },
            {
                kategori: 'Kesehatan',
                pertanyaan: 'Berapakah Denyut Nadi Maksimal (DNM) teoritis seorang siswa yang berusia 15 tahun?',
                pilihan: [
                    '185 denyut per menit (bpm)',
                    '195 denyut per menit (bpm)',
                    '205 denyut per menit (bpm)',
                    '220 denyut per menit (bpm)'
                ],
                jawabanBenar: 2,
                pembahasan: 'Rumus Denyut Nadi Maksimal (DNM) adalah 220 - Usia. Maka untuk siswa berusia 15 tahun: 220 - 15 = 205 bpm.'
            }
        ];

        // ==========================================
        // 3. LOGIKA RENDER KATALOG MATERI & MODAL
        // ==========================================
        const materiGrid = document.getElementById('materiGrid');
        const filterBtns = document.querySelectorAll('.filter-btn');
        const searchInput = document.getElementById('searchMateri');
        const materiModal = document.getElementById('materiModal');

        let activeCategory = 'Semua';
        let searchQuery = '';

        function renderMateriCards() {
            const filtered = materiPJOK.filter(item => {
                const matchCat = activeCategory === 'Semua' || item.kategori === activeCategory;
                const q = searchQuery.toLowerCase();
                const matchSearch = item.judul.toLowerCase().includes(q) || 
                                    item.ringkasan.toLowerCase().includes(q) ||
                                    item.kategori.toLowerCase().includes(q);
                return matchCat && matchSearch;
            });

            if (filtered.length === 0) {
                materiGrid.innerHTML = `
                    <div class="col-span-full text-center py-12 bg-white rounded-3xl border border-slate-200">
                        <div class="text-4xl mb-3">🔍</div>
                        <h3 class="text-lg font-bold text-slate-800">Materi tidak ditemukan</h3>
                        <p class="text-sm text-slate-500 mt-1">Coba gunakan kata kunci lain atau pilih kategori "Semua Materi".</p>
                    </div>
                `;
                return;
            }

            materiGrid.innerHTML = filtered.map(item => `
                <article onclick="openMateriModal('${item.id}')" 
                    class="group bg-white rounded-3xl p-6 border border-slate-200/90 shadow-sm hover:shadow-xl hover:shadow-sky-900/5 hover:-translate-y-1 transition-all duration-300 cursor-pointer flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between gap-2 mb-4">
                            <span class="px-3 py-1 rounded-xl text-xs font-bold ${item.warnaBadge}">
                                ${item.kategori}
                            </span>
                            <span class="text-3xl group-hover:scale-110 transition-transform">${item.emoji}</span>
                        </div>
                        <h3 class="text-xl font-extrabold text-slate-900 group-hover:text-sky-600 transition-colors mb-2">
                            ${item.judul}
                        </h3>
                        <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">
                            ${item.ringkasan}
                        </p>
                    </div>

                    <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between">
                        <span class="text-xs font-semibold text-slate-400">
                            ${item.teknikDasar.length} Teknik Utama
                        </span>
                        <span class="inline-flex items-center gap-1.5 text-sm font-bold text-sky-600 group-hover:translate-x-1 transition-transform">
                            <span>Pelajari Materi</span>
                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                        </span>
                    </div>
                </article>
            `).join('');

            lucide.createIcons();
        }

        // Event Filter Kategori
        filterBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                filterBtns.forEach(b => {
                    b.classList.remove('active', 'bg-sky-600', 'text-white', 'shadow-sm');
                    b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
                });
                btn.classList.add('active', 'bg-sky-600', 'text-white', 'shadow-sm');
                btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');
                
                activeCategory = btn.getAttribute('data-category');
                renderMateriCards();
            });
        });

        // Event Pencarian
        searchInput.addEventListener('input', (e) => {
            searchQuery = e.target.value;
            renderMateriCards();
        });

        // Buka Modal Detail Materi
        window.openMateriModal = function(id) {
            const item = materiPJOK.find(m => m.id === id);
            if (!item) return;

            const banner = document.getElementById('modalHeaderBanner');
            banner.className = `px-6 py-5 bg-gradient-to-r ${item.bannerGradient} text-white flex justify-between items-start gap-4`;

            document.getElementById('modalEmoji').textContent = item.emoji;
            document.getElementById('modalCategory').textContent = item.kategori;
            document.getElementById('modalTitle').textContent = item.judul;
            document.getElementById('modalDescription').textContent = item.deskripsiLengkap;
            document.getElementById('modalSafetyTip').textContent = item.tipsKeselamatan;

            const techList = document.getElementById('modalTechniquesList');
            techList.innerHTML = item.teknikDasar.map(tech => `
                <div class="p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-2.5">
                    <h5 class="font-bold text-slate-900 text-sm sm:text-base">${tech.nama}</h5>
                    <ul class="space-y-2">
                        ${tech.langkah.map((step, idx) => `
                            <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700">
                                <span class="w-5 h-5 rounded-full bg-sky-100 text-sky-700 font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">
                                    ${idx + 1}
                                </span>
                                <span class="leading-relaxed">${step}</span>
                            </li>
                        `).join('')}
                    </ul>
                </div>
            `).join('');

            materiModal.classList.remove('hidden');
            materiModal.classList.add('flex');
            document.body.style.overflow = 'hidden';
            lucide.createIcons();
        };

        function closeMateriModal() {
            materiModal.classList.add('hidden');
            materiModal.classList.remove('flex');
            document.body.style.overflow = '';
        }

        document.getElementById('closeModalBtn').addEventListener('click', closeMateriModal);
        document.getElementById('closeModalFooterBtn').addEventListener('click', closeMateriModal);
        document.getElementById('modalGoQuizBtn').addEventListener('click', closeMateriModal);
        materiModal.addEventListener('click', (e) => {
            if (e.target === materiModal) closeMateriModal();
        });

        // ==========================================
        // 4. LOGIKA KUIS INTERAKTIF PJOK
        // ==========================================
        let currentQuestionIndex = 0;
        let scoreCount = 0;
        let timerInterval = null;
        let timeLeft = 30;
        let userAnswersHistory = [];
        let hasAnsweredCurrent = false;

        const quizStartScreen = document.getElementById('quizStartScreen');
        const quizPlayScreen = document.getElementById('quizPlayScreen');
        const quizResultScreen = document.getElementById('quizResultScreen');

        document.getElementById('startQuizBtn').addEventListener('click', startQuiz);
        document.getElementById('nextQuestionBtn').addEventListener('click', nextQuestion);
        document.getElementById('restartQuizBtn').addEventListener('click', startQuiz);

        function startQuiz() {
            currentQuestionIndex = 0;
            scoreCount = 0;
            userAnswersHistory = [];
            quizStartScreen.classList.add('hidden');
            quizResultScreen.classList.add('hidden');
            quizPlayScreen.classList.remove('hidden');
            loadQuestion();
        }

        function loadQuestion() {
            hasAnsweredCurrent = false;
            clearInterval(timerInterval);
            timeLeft = 30;

            const qData = bankSoalKuis[currentQuestionIndex];
            document.getElementById('quizQuestionNumber').textContent = `Soal ${currentQuestionIndex + 1} / ${bankSoalKuis.length}`;
            document.getElementById('quizCategoryBadge').textContent = qData.kategori;
            document.getElementById('quizQuestionText').textContent = qData.pertanyaan;
            
            const progressPercent = ((currentQuestionIndex + 1) / bankSoalKuis.length) * 100;
            document.getElementById('quizProgressBar').style.width = `${progressPercent}%`;

            // Sembunyikan box pembahasan & tombol lanjut
            const expBox = document.getElementById('quizExplanationBox');
            expBox.classList.add('hidden');
            document.getElementById('nextQuestionBtn').classList.add('hidden');

            // Render tombol pilihan
            const optionsContainer = document.getElementById('quizOptionsContainer');
            const optionLetters = ['A', 'B', 'C', 'D'];
            optionsContainer.innerHTML = qData.pilihan.map((opt, index) => `
                <button onclick="selectAnswer(${index})" data-opt-index="${index}"
                    class="quiz-opt-btn w-full text-left p-4 rounded-2xl border-2 border-slate-200 hover:border-sky-500 hover:bg-sky-50/60 transition-all flex items-center gap-3.5 group">
                    <span class="w-8 h-8 rounded-xl bg-slate-100 group-hover:bg-sky-600 group-hover:text-white text-slate-700 font-bold text-sm flex items-center justify-center shrink-0 transition-colors">
                        ${optionLetters[index]}
                    </span>
                    <span class="text-sm sm:text-base font-medium text-slate-800">${opt}</span>
                </button>
            `).join('');

            // Mulai Timer 30 Detik
            updateTimerUI();
            timerInterval = setInterval(() => {
                timeLeft--;
                updateTimerUI();
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    handleTimeOut();
                }
            }, 1000);
        }

        function updateTimerUI() {
            const timerEl = document.getElementById('quizTimerDisplay');
            timerEl.textContent = `${timeLeft}d`;
        }

        window.selectAnswer = function(selectedIndex) {
            if (hasAnsweredCurrent) return;
            hasAnsweredCurrent = true;
            clearInterval(timerInterval);

            const qData = bankSoalKuis[currentQuestionIndex];
            const isCorrect = selectedIndex === qData.jawabanBenar;
            if (isCorrect) scoreCount++;

            userAnswersHistory.push({
                pertanyaan: qData.pertanyaan,
                jawabanUser: qData.pilihan[selectedIndex],
                jawabanBenarText: qData.pilihan[qData.jawabanBenar],
                isCorrect: isCorrect,
                pembahasan: qData.pembahasan
            });

            highlightOptionButtons(selectedIndex, qData.jawabanBenar);
            showExplanation(isCorrect ? 'Tepat Sekali! Jawaban Benar 🎉' : 'Kurang Tepat, Tetap Semangat! 💡', qData.pembahasan, isCorrect);
        };

        function handleTimeOut() {
            if (hasAnsweredCurrent) return;
            hasAnsweredCurrent = true;

            const qData = bankSoalKuis[currentQuestionIndex];
            userAnswersHistory.push({
                pertanyaan: qData.pertanyaan,
                jawabanUser: 'Waktu Habis (Tidak Menjawab)',
                jawabanBenarText: qData.pilihan[qData.jawabanBenar],
                isCorrect: false,
                pembahasan: qData.pembahasan
            });

            highlightOptionButtons(-1, qData.jawabanBenar);
            showExplanation('Waktu Habis! ⏰', qData.pembahasan, false);
        }

        function highlightOptionButtons(selectedIndex, correctIndex) {
            const buttons = document.querySelectorAll('.quiz-opt-btn');
            buttons.forEach((btn, idx) => {
                btn.disabled = true;
                btn.classList.remove('hover:border-sky-500', 'hover:bg-sky-50/60');

                if (idx === correctIndex) {
                    btn.classList.remove('border-slate-200');
                    btn.classList.add('border-emerald-500', 'bg-emerald-50');
                } else if (idx === selectedIndex && selectedIndex !== correctIndex) {
                    btn.classList.remove('border-slate-200');
                    btn.classList.add('border-rose-500', 'bg-rose-50');
                } else {
                    btn.classList.add('opacity-60');
                }
            });
        }

        function showExplanation(title, text, isCorrect) {
            const expBox = document.getElementById('quizExplanationBox');
            const titleEl = document.getElementById('quizFeedbackTitle');
            const textEl = document.getElementById('quizExplanationText');

            expBox.className = `p-4 sm:p-5 rounded-2xl border text-sm space-y-1.5 animate-fade-in ${
                isCorrect ? 'bg-emerald-50/90 border-emerald-200 text-emerald-900' : 'bg-amber-50/90 border-amber-200 text-amber-900'
            }`;
            titleEl.textContent = title;
            textEl.textContent = text;
            expBox.classList.remove('hidden');

            const nextBtn = document.getElementById('nextQuestionBtn');
            nextBtn.querySelector('span').textContent = 
                currentQuestionIndex === bankSoalKuis.length - 1 ? 'Lihat Hasil Akhir' : 'Soal Berikutnya';
            nextBtn.classList.remove('hidden');
            lucide.createIcons();
        }

        function nextQuestion() {
            currentQuestionIndex++;
            if (currentQuestionIndex < bankSoalKuis.length) {
                loadQuestion();
            } else {
                showQuizResults();
            }
        }

        function showQuizResults() {
            quizPlayScreen.classList.add('hidden');
            quizResultScreen.classList.remove('hidden');

            const total = bankSoalKuis.length;
            const finalScore = Math.round((scoreCount / total) * 100);
            const wrongCount = total - scoreCount;

            document.getElementById('finalScoreText').textContent = finalScore;
            document.getElementById('correctCountText').textContent = scoreCount;
            document.getElementById('wrongCountText').textContent = wrongCount;

            const predicateEl = document.getElementById('resultPredicate');
            const messageEl = document.getElementById('resultMessage');
            const iconEl = document.getElementById('resultIconContainer');

            if (finalScore >= 80) {
                iconEl.textContent = '🏆';
                predicateEl.textContent = 'Sangat Memuaskan! Juara PJOK!';
                messageEl.textContent = 'Pemahamanmu tentang teknik olahraga, kebugaran, dan kesehatan sudah sangat kuat.';
            } else if (finalScore >= 60) {
                iconEl.textContent = '🥈';
                predicateEl.textContent = 'Bagus! Terus Tingkatkan!';
                messageEl.textContent = 'Kamu sudah memahami sebagian besar materi. Baca kembali modul teknik dasar untuk menyempurnakan nilaimu.';
            } else {
                iconEl.textContent = '💪';
                predicateEl.textContent = 'Ayo Belajar Lagi!';
                messageEl.textContent = 'Jangan menyerah! Pelajari kembali katalog materi PJOK di atas lalu coba ulangi kuis ini.';
            }

            // Render Review List
            const reviewList = document.getElementById('quizReviewList');
            reviewList.innerHTML = userAnswersHistory.map((item, i) => `
                <div class="p-3.5 rounded-2xl border ${item.isCorrect ? 'bg-emerald-50/50 border-emerald-200' : 'bg-rose-50/50 border-rose-200'} text-xs sm:text-sm space-y-1">
                    <div class="font-bold text-slate-900">${i + 1}. ${item.pertanyaan}</div>
                    <div class="${item.isCorrect ? 'text-emerald-700' : 'text-rose-700'} font-semibold">
                        Jawabanmu: ${item.jawabanUser} ${item.isCorrect ? '✓' : '✗'}
                    </div>
                    ${!item.isCorrect ? `<div class="text-emerald-700 font-semibold">Kunci Jawaban: ${item.jawabanBenarText}</div>` : ''}
                    <p class="text-slate-600 pt-0.5">${item.pembahasan}</p>
                </div>
            `).join('');

            lucide.createIcons();
        }

        // ==========================================
        // 5. LOGIKA KALKULATOR BMI & DENYUT NADI
        // ==========================================
        document.getElementById('bmiForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const berat = parseFloat(document.getElementById('beratBadan').value);
            const tinggiCm = parseFloat(document.getElementById('tinggiBadan').value);

            if (!berat || !tinggiCm || tinggiCm <= 0) return;

            const tinggiM = tinggiCm / 100;
            const bmi = berat / (tinggiM * tinggiM);
            const bmiFixed = bmi.toFixed(1);

            const scoreEl = document.getElementById('bmiScoreValue');
            const badgeEl = document.getElementById('bmiCategoryBadge');
            const adviceEl = document.getElementById('bmiAdviceText');

            scoreEl.textContent = bmiFixed;

            let category = '';
            let badgeClass = '';
            let advice = '';

            // Standar Klasifikasi IMT Nasional (Kemenkes RI)
            if (bmi < 18.5) {
                category = 'Berat Badan Kurang (Kurus)';
                badgeClass = 'bg-sky-100 text-sky-800';
                advice = 'Tingkatkan asupan kalori bergizi seimbang (protein & karbohidrat kompleks) disertai latihan kekuatan otot untuk membangun massa tubuh ideal.';
            } else if (bmi >= 18.5 && bmi <= 25.0) {
                category = 'Berat Badan Normal (Ideal)';
                badgeClass = 'bg-emerald-100 text-emerald-800';
                advice = 'Pertahankan berat badan idealmu dengan rutin berolahraga minimal 3–5 kali seminggu dan menjaga pola makan gizi seimbang!';
            } else if (bmi > 25.0 && bmi <= 27.0) {
                category = 'Kelebihan Berat Badan Ringan';
                badgeClass = 'bg-amber-100 text-amber-800';
                advice = 'Perbanyak aktivitas kardiovaskular (jogging, bersepeda, renang) dan kurangi makanan tinggi gula serta gorengan.';
            } else {
                category = 'Obesitas (Perlu Perhatian)';
                badgeClass = 'bg-rose-100 text-rose-800';
                advice = 'Mulailah olahraga intensitas ringan-sedang secara rutin (seperti jalan cepat atau berenang) serta konsultasikan pola makan sehat.';
            }

            badgeEl.textContent = category;
            badgeEl.className = `px-3 py-1 rounded-full text-xs font-bold ${badgeClass}`;
            adviceEl.textContent = advice;
        });

        document.getElementById('hrForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const usia = parseInt(document.getElementById('usiaSiswa').value, 10);
            if (!usia || usia < 5) return;

            const dnm = 220 - usia;
            document.getElementById('dnmValue').innerHTML = `${dnm} <span class="text-xs font-semibold text-slate-500">bpm</span>`;

            const lightMin = Math.round(dnm * 0.50);
            const lightMax = Math.round(dnm * 0.60);

            const modMin = Math.round(dnm * 0.60);
            const modMax = Math.round(dnm * 0.70);

            const vigMin = Math.round(dnm * 0.70);
            const vigMax = Math.round(dnm * 0.85);

            document.getElementById('zoneLight').textContent = `${lightMin} - ${lightMax} bpm`;
            document.getElementById('zoneModerate').textContent = `${modMin} - ${modMax} bpm`;
            document.getElementById('zoneVigorous').textContent = `${vigMin} - ${vigMax} bpm`;
        });

        // ==========================================
        // 6. MENU MOBILE & INISIALISASI AWAL
        // ==========================================
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');

        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        document.querySelectorAll('.mobile-nav-link').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.add('hidden');
            });
        });

        window.addEventListener('DOMContentLoaded', () => {
            renderMateriCards();
            lucide.createIcons();
        });
    </script>
</body>
</html>
