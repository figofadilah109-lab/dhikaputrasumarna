<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Pembelajaran PJOK - Pendidikan Jasmani, Olahraga, dan Kesehatan</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        sport: {
                            blue: '#0284c7',
                            darkBlue: '#0369a1',
                            orange: '#f97316',
                            green: '#10b981',
                            slate: '#f8fafc'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        h1, h2, h3, .font-display {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        /* Custom scrollbar untuk modal */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .hero-pattern {
            background-color: #0284c7;
            background-image: radial-gradient(at 80% 0%, hsla(24, 95%, 53%, 0.45) 0px, transparent 50%),
                              radial-gradient(at 0% 100%, hsla(158, 84%, 39%, 0.45) 0px, transparent 50%);
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeIn 0.35s ease-out forwards;
        }
    </style>
</head>
<body class="antialiased selection:bg-orange-500 selection:text-white">

    <!-- 1. HEADER & NAVIGASI MODERN -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16 md:h-20">
                <!-- Logo & Judul Aplikasi -->
                <a href="#beranda" class="flex items-center gap-3 group">
                    <div class="w-10 h-10 md:w-11 md:h-11 rounded-2xl bg-gradient-to-tr from-sky-600 via-sky-500 to-emerald-500 flex items-center justify-center text-white shadow-md shadow-sky-500/20 group-hover:scale-105 transition-transform">
                        <i data-lucide="trophy" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <span class="font-display font-extrabold text-lg md:text-xl tracking-tight text-slate-900 block leading-none">
                            Portal Pembelajaran <span class="text-sky-600">PJOK</span>
                        </span>
                        <span class="text-[11px] font-medium text-slate-500 hidden sm:block mt-0.5">
                            Pendidikan Jasmani, Olahraga & Kesehatan
                        </span>
                    </div>
                </a>

                <!-- Menu Navigasi Desktop -->
                <nav class="hidden md:flex items-center gap-1 lg:gap-2">
                    <a href="#beranda" class="nav-link px-4 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:text-sky-600 hover:bg-sky-50 transition-colors">
                        Beranda
                    </a>
                    <a href="#materi" class="nav-link px-4 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:text-sky-600 hover:bg-sky-50 transition-colors">
                        Materi Olahraga
                    </a>
                    <a href="#kuis" class="nav-link px-4 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:text-sky-600 hover:bg-sky-50 transition-colors">
                        Kuis Interaktif
                    </a>
                    <a href="#kalkulator" class="nav-link px-4 py-2 rounded-xl text-sm font-semibold text-slate-700 hover:text-sky-600 hover:bg-sky-50 transition-colors">
                        Kalkulator BMI & Kebugaran
                    </a>
                </nav>

                <!-- Tombol Aksi Cepat & Menu Mobile -->
                <div class="flex items-center gap-2">
                    <a href="#materi" class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-orange-500 hover:bg-orange-600 text-white text-sm font-semibold shadow-sm shadow-orange-500/20 transition-all">
                        <i data-lucide="book-open" class="w-4 h-4"></i>
                        <span>Mulai Belajar</span>
                    </a>
                    <button id="mobileMenuBtn" aria-label="Buka Menu" class="md:hidden p-2.5 rounded-xl text-slate-600 hover:bg-slate-100 focus:outline-none">
                        <i data-lucide="menu" class="w-6 h-6"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Dropdown Navigasi Mobile -->
        <div id="mobileMenu" class="hidden md:hidden bg-white border-t border-slate-100 px-4 pt-2 pb-4 space-y-1 shadow-lg">
            <a href="#beranda" class="mobile-nav-link block px-4 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-sky-50 hover:text-sky-600">
                🏠 Beranda
            </a>
            <a href="#materi" class="mobile-nav-link block px-4 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-sky-50 hover:text-sky-600">
                📚 Materi Olahraga
            </a>
            <a href="#kuis" class="mobile-nav-link block px-4 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-sky-50 hover:text-sky-600">
                🎯 Kuis Interaktif
            </a>
            <a href="#kalkulator" class="mobile-nav-link block px-4 py-3 rounded-xl text-sm font-semibold text-slate-700 hover:bg-sky-50 hover:text-sky-600">
                ❤️ Kalkulator BMI & Kebugaran
            </a>
        </div>
    </header>

    <main>
        <!-- 2. HERO SECTION ENERGETIK -->
        <section id="beranda" class="relative overflow-hidden hero-pattern text-white py-14 sm:py-20 lg:py-24">
            <!-- Dekorasi Latar Abstrak -->
            <div class="absolute inset-0 opacity-10 pointer-events-none">
                <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="none">
                    <circle cx="15" cy="20" r="18" fill="white" />
                    <circle cx="88" cy="75" r="25" fill="white" />
                    <path d="M0 85 Q 50 55 100 85 L 100 100 L 0 100 Z" fill="white" />
                </svg>
            </div>

            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                    <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/15 backdrop-blur-sm border border-white/25 text-xs sm:text-sm font-semibold text-white">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                            <span>Media Belajar Interaktif Siswa & Guru PJOK</span>
                        </div>
                        
                        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight leading-tight">
                            Bergerak Aktif, Pahami Teknik, & Raih <span class="text-amber-300">Tubuh Bugar!</span>
                        </h1>
                        
                        <p class="text-base sm:text-lg text-sky-50 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
                            Pelajari teknik dasar berbagai cabang olahraga, uji pemahamanmu melalui kuis interaktif, dan pantau status kebugaran tubuhmu secara mandiri dalam satu platform.
                        </p>

                        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
                            <a href="#materi" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-orange-500 hover:bg-orange-600 text-white font-bold text-base shadow-lg shadow-orange-900/20 transition-all hover:-translate-y-0.5">
                                <i data-lucide="play-circle" class="w-5 h-5"></i>
                                <span>Jelajahi Materi</span>
                            </a>
                            <a href="#kuis" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-white text-sky-700 hover:bg-sky-50 font-bold text-base shadow-lg transition-all hover:-translate-y-0.5">
                                <i data-lucide="brain-circuit" class="w-5 h-5 text-emerald-600"></i>
                                <span>Mulai Kuis PJOK</span>
                            </a>
                        </div>

                        <!-- Statistik Ringkas -->
                        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-white/20 max-w-lg mx-auto lg:mx-0">
                            <div>
                                <div class="text-2xl sm:text-3xl font-extrabold text-white">5</div>
                                <div class="text-xs sm:text-sm text-sky-100">Ruang Lingkup</div>
                            </div>
                            <div>
                                <div class="text-2xl sm:text-3xl font-extrabold text-amber-300">11+</div>
                                <div class="text-xs sm:text-sm text-sky-100">Modul Teknik</div>
                            </div>
                            <div>
                                <div class="text-2xl sm:text-3xl font-extrabold text-emerald-300">100%</div>
                                <div class="text-xs sm:text-sm text-sky-100">Interaktif</div>
                            </div>
                        </div>
                    </div>

                    <!-- Ilustrasi Kartu Fitur Unggulan Hero -->
                    <div class="lg:col-span-5">
                        <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-6 sm:p-8 shadow-2xl space-y-5">
                            <div class="flex items-center justify-between border-b border-white/15 pb-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-emerald-400 text-slate-900 flex items-center justify-center font-bold">
                                        <i data-lucide="activity" class="w-6 h-6"></i>
                                    </div>
                                    <div>
                                        <h2 class="font-bold text-white text-base">Panduan Praktik PJOK</h2>
                                        <p class="text-xs text-sky-100">Kurikulum Merdeka & Nasional</p>
                                    </div>
                                </div>
                                <span class="px-2.5 py-1 rounded-lg bg-emerald-500/30 border border-emerald-300/40 text-xs font-semibold text-emerald-200">
                                    Siap Belajar
                                </span>
                            </div>

                            <div class="space-y-3">
                                <div class="p-3.5 rounded-2xl bg-white/10 flex items-center gap-3.5">
                                    <span class="text-2xl">⚽</span>
                                    <div class="flex-1">
                                        <div class="text-sm font-bold">Permainan Bola Besar & Kecil</div>
                                        <div class="text-xs text-sky-100">Sepak Bola, Basket, Voli, Bulu Tangkis, Tenis Meja</div>
                                    </div>
                                </div>
                                <div class="p-3.5 rounded-2xl bg-white/10 flex items-center gap-3.5">
                                    <span class="text-2xl">🏃‍♂️</span>
                                    <div class="flex-1">
                                        <div class="text-sm font-bold">Atletik & Kebugaran Jasmani</div>
                                        <div class="text-xs text-sky-100">Lari Jarak Pendek, Lompat Jauh, Latihan Fisik</div>
                                    </div>
                                </div>
                                <div class="p-3.5 rounded-2xl bg-white/10 flex items-center gap-3.5">
                                    <span class="text-2xl">🥗</span>
                                    <div class="flex-1">
                                        <div class="text-sm font-bold">Kesehatan & P3K Cedera (RICE)</div>
                                        <div class="text-xs text-sky-100">Gizi Seimbang & Penanganan Cedera Olahraga</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. KATALOG MATERI PEMBELAJARAN PJOK -->
        <section id="materi" class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-10">
                <span class="inline-block px-3.5 py-1 rounded-full bg-sky-100 text-sky-700 font-bold text-xs uppercase tracking-wider mb-3">
                    Modul Pembelajaran Terstruktur
                </span>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900">
                    Katalog Materi Pembelajaran PJOK
                </h2>
                <p class="mt-3 text-slate-600 text-sm sm:text-base">
                    Pilih kategori di bawah ini atau klik kartu materi untuk mempelajari pengertian, teknik dasar langkah demi langkah, serta tips keselamatan berolahraga.
                </p>
            </div>

            <!-- Filter Kategori & Pencarian -->
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-8">
                <div id="categoryFilters" class="flex flex-wrap justify-center gap-2">
                    <button data-category="Semua" class="filter-btn active px-4 py-2 rounded-xl text-sm font-semibold bg-sky-600 text-white shadow-sm transition-all">
                        Semua Materi
                    </button>
                    <button data-category="Bola Besar" class="filter-btn px-4 py-2 rounded-xl text-sm font-semibold bg-white text-slate-600 hover:bg-sky-50 border border-slate-200 transition-all">
                        ⚽ Bola Besar
                    </button>
                    <button data-category="Bola Kecil" class="filter-btn px-4 py-2 rounded-xl text-sm font-semibold bg-white text-slate-600 hover:bg-sky-50 border border-slate-200 transition-all">
                        🏸 Bola Kecil
                    </button>
                    <button data-category="Atletik" class="filter-btn px-4 py-2 rounded-xl text-sm font-semibold bg-white text-slate-600 hover:bg-sky-50 border border-slate-200 transition-all">
                        🏃 Atletik
                    </button>
                    <button data-category="Kebugaran Jasmani" class="filter-btn px-4 py-2 rounded-xl text-sm font-semibold bg-white text-slate-600 hover:bg-sky-50 border border-slate-200 transition-all">
                        💪 Kebugaran Jasmani
                    </button>
                    <button data-category="Kesehatan" class="filter-btn px-4 py-2 rounded-xl text-sm font-semibold bg-white text-slate-600 hover:bg-sky-50 border border-slate-200 transition-all">
                        🩺 Kesehatan & P3K
                    </button>
                </div>

                <!-- Kotak Pencarian Materi -->
                <div class="relative w-full md:w-72">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                    <input type="text" id="searchMateri" placeholder="Cari materi atau teknik..." class="w-full pl-10 pr-4 py-2.5 rounded-xl bg-white border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 focus:border-sky-500">
                </div>
            </div>

            <!-- Grid Kartu Materi -->
            <div id="materiGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Di-render secara dinamis melalui JavaScript -->
            </div>
        </section>

        <!-- 4. KUIS INTERAKTIF PJOK -->
        <section id="kuis" class="py-16 sm:py-20 bg-gradient-to-b from-slate-100/80 to-white border-y border-slate-200/80">
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-10">
                    <span class="inline-block px-3.5 py-1 rounded-full bg-orange-100 text-orange-700 font-bold text-xs uppercase tracking-wider mb-3">
                        Evaluasi Pemahaman Siswa
                    </span>
                    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900">
                        Kuis Interaktif PJOK
                    </h2>
                    <p class="mt-2 text-slate-600 text-sm sm:text-base">
                        Uji pengetahuanmu seputar aturan permainan, teknik dasar olahraga, kebugaran, dan kesehatan!
                    </p>
                </div>

                <!-- Kontainer Utama Kuis -->
                <div class="bg-white rounded-3xl shadow-xl shadow-slate-200/60 border border-slate-200/80 overflow-hidden">
                    
                    <!-- Layar Awal Kuis -->
                    <div id="quizStartScreen" class="p-8 sm:p-12 text-center space-y-6">
                        <div class="w-20 h-20 mx-auto rounded-3xl bg-gradient-to-br from-orange-400 to-amber-500 text-white flex items-center justify-center shadow-lg shadow-orange-500/25">
                            <i data-lucide="award" class="w-10 h-10"></i>
                        </div>
                        <div class="space-y-2 max-w-lg mx-auto">
                            <h3 class="text-2xl font-extrabold text-slate-900">Siap Menguji Wawasan Olahragamu?</h3>
                            <p class="text-slate-600 text-sm sm:text-base">
                                Terdiri dari <strong>10 soal pilihan ganda</strong> mencakup materi Bola Besar, Bola Kecil, Atletik, Kebugaran Jasmani, dan Kesehatan. Dilengkapi batas waktu 30 detik per soal serta pembahasan lengkap!
                            </p>
                        </div>
                        <div class="flex flex-wrap justify-center gap-4 text-xs sm:text-sm font-medium text-slate-600">
                            <span class="px-3.5 py-2 rounded-xl bg-slate-100 flex items-center gap-1.5">
                                <i data-lucide="help-circle" class="w-4 h-4 text-sky-600"></i> 10 Pertanyaan
                            </span>
                            <span class="px-3.5 py-2 rounded-xl bg-slate-100 flex items-center gap-1.5">
                                <i data-lucide="timer" class="w-4 h-4 text-orange-500"></i> 30 Detik / Soal
                            </span>
                            <span class="px-3.5 py-2 rounded-xl bg-slate-100 flex items-center gap-1.5">
                                <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i> Pembahasan Otomatis
                            </span>
                        </div>
                        <div class="pt-2">
                            <button id="startQuizBtn" class="px-8 py-4 rounded-2xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-base shadow-lg shadow-sky-600/25 transition-all hover:scale-105">
                                Mulai Kuis Sekarang 🚀
                            </button>
                        </div>
                    </div>

                    <!-- Layar Pertanyaan Kuis -->
                    <div id="quizPlayScreen" class="hidden p-6 sm:p-10 space-y-6">
                        <!-- Header Status Soal & Timer -->
                        <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-100">
                            <div class="flex items-center gap-3">
                                <span id="quizQuestionNumber" class="px-3.5 py-1.5 rounded-xl bg-sky-100 text-sky-700 font-bold text-sm">
                                    Soal 1 / 10
                                </span>
                                <span id="quizCategoryBadge" class="px-3 py-1 rounded-lg bg-slate-100 text-slate-600 font-semibold text-xs">
                                    Bola Besar
                                </span>
                            </div>

                            <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-orange-50 border border-orange-200 text-orange-700 font-bold text-sm">
                                <i data-lucide="clock" class="w-4 h-4"></i>
                                <span id="quizTimerDisplay">30d</span>
                            </div>
                        </div>

                        <!-- Progress Bar -->
                        <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
                            <div id="quizProgressBar" class="bg-gradient-to-r from-sky-500 to-emerald-500 h-full transition-all duration-300" style="width: 10%;"></div>
                        </div>

                        <!-- Teks Pertanyaan -->
                        <div>
                            <h3 id="quizQuestionText" class="text-lg sm:text-xl font-bold text-slate-900 leading-snug">
                                Pertanyaan akan muncul di sini...
                            </h3>
                        </div>

                        <!-- Pilihan Jawaban -->
                        <div id="quizOptionsContainer" class="space-y-3">
                            <!-- Tombol pilihan jawaban dirender JS -->
                        </div>

                        <!-- Kotak Pembahasan Langsung -->
                        <div id="quizExplanationBox" class="hidden p-4 sm:p-5 rounded-2xl border text-sm space-y-1.5 animate-fade-in">
                            <div id="quizFeedbackTitle" class="font-bold text-base flex items-center gap-2"></div>
                            <p id="quizExplanationText" class="text-slate-700 leading-relaxed"></p>
                        </div>

                        <!-- Tombol Navigasi Soal -->
                        <div class="flex justify-end pt-2">
                            <button id="nextQuestionBtn" class="hidden px-6 py-3 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-sm shadow-md transition-all flex items-center gap-2">
                                <span>Soal Berikutnya</span>
                                <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Layar Hasil Akhir Kuis -->
                    <div id="quizResultScreen" class="hidden p-8 sm:p-12 text-center space-y-6 animate-fade-in">
                        <div id="resultIconContainer" class="w-24 h-24 mx-auto rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center text-4xl shadow-inner">
                            🏆
                        </div>
                        <div class="space-y-2">
                            <span class="text-xs font-bold uppercase tracking-wider text-sky-600">Hasil Evaluasi Kuis PJOK</span>
                            <h3 id="resultPredicate" class="text-2xl sm:text-3xl font-extrabold text-slate-900">Luar Biasa!</h3>
                            <p id="resultMessage" class="text-slate-600 text-sm sm:text-base max-w-md mx-auto">
                                Kamu menguasai konsep dasar pendidikan jasmani dan kesehatan dengan sangat baik.
                            </p>
                        </div>

                        <!-- Kartu Skor -->
                        <div class="grid grid-cols-3 gap-3 sm:gap-4 max-w-md mx-auto">
                            <div class="p-4 rounded-2xl bg-sky-50 border border-sky-100">
                                <div class="text-xs font-semibold text-sky-700">Nilai Akhir</div>
                                <div id="finalScoreText" class="text-2xl sm:text-3xl font-extrabold text-sky-600 mt-1">100</div>
                            </div>
                            <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-100">
                                <div class="text-xs font-semibold text-emerald-700">Benar</div>
                                <div id="correctCountText" class="text-2xl sm:text-3xl font-extrabold text-emerald-600 mt-1">10</div>
                            </div>
                            <div class="p-4 rounded-2xl bg-rose-50 border border-rose-100">
                                <div class="text-xs font-semibold text-rose-700">Salah</div>
                                <div id="wrongCountText" class="text-2xl sm:text-3xl font-extrabold text-rose-600 mt-1">0</div>
                            </div>
                        </div>

                        <!-- Ringkasan Review Jawaban -->
                        <div class="text-left max-w-2xl mx-auto pt-4">
                            <h4 class="font-bold text-slate-800 text-sm mb-3 flex items-center gap-2">
                                <i data-lucide="list-checks" class="w-4 h-4 text-sky-600"></i>
                                <span>Ringkasan Jawaban & Pembahasan:</span>
                            </h4>
                            <div id="quizReviewList" class="space-y-3 max-h-72 overflow-y-auto pr-1">
                                <!-- Diisi JS -->
                            </div>
                        </div>

                        <div class="pt-4">
                            <button id="restartQuizBtn" class="px-7 py-3.5 rounded-2xl bg-orange-500 hover:bg-orange-600 text-white font-bold text-sm sm:text-base shadow-lg shadow-orange-500/20 transition-all inline-flex items-center gap-2">
                                <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                                <span>Ulangi Kuis</span>
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </section>

        <!-- 5. KALKULATOR KEBUGARAN (BMI & ZONA DENYUT NADI LATIHAN) -->
        <section id="kalkulator" class="py-16 sm:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-12">
                <span class="inline-block px-3.5 py-1 rounded-full bg-emerald-100 text-emerald-700 font-bold text-xs uppercase tracking-wider mb-3">
                    Cek Kondisi Tubuh Mandiri
                </span>
                <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900">
                    Kalkulator BMI & Zona Denyut Nadi
                </h2>
                <p class="mt-3 text-slate-600 text-sm sm:text-base">
                    Hitung Indeks Massa Tubuh (IMT/BMI) untuk mengetahui status gizi serta temukan zona denyut nadi latihan yang aman dan efektif sesuai usiamu.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- KALKULATOR 1: INDEKS MASSA TUBUH (BMI) -->
                <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-lg shadow-slate-200/50 border border-slate-200/80 flex flex-col justify-between space-y-6">
                    <div class="space-y-5">
                        <div class="flex items-center gap-3.5">
                            <div class="w-12 h-12 rounded-2xl bg-sky-100 text-sky-600 flex items-center justify-center">
                                <i data-lucide="scale" class="w-6 h-6"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-extrabold text-slate-900">Kalkulator Indeks Massa Tubuh (BMI)</h3>
                                <p class="text-xs sm:text-sm text-slate-500">Standar Kemenkes RI untuk evaluasi berat badan ideal</p>
                            </div>
                        </div>

                        <form id="bmiForm" class="space-y-4">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label for="beratBadan" class="block text-sm font-semibold text-slate-700 mb-1.5">
                                        Berat Badan (kg)
                                    </label>
                                    <input type="number" id="beratBadan" step="0.1" min="15" max="250" placeholder="Contoh: 55" required
                                        class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 font-medium focus:outline-none focus:ring-2 focus:ring-sky-500">
                                </div>
                                <div>
                                    <label for="tinggiBadan" class="block text-sm font-semibold text-slate-700 mb-1.5">
                                        Tinggi Badan (cm)
                                    </label>
                                    <input type="number" id="tinggiBadan" step="0.1" min="80" max="250" placeholder="Contoh: 165" required
                                        class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 font-medium focus:outline-none focus:ring-2 focus:ring-sky-500">
                                </div>
                            </div>
                            <button type="submit" class="w-full py-3.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-sm sm:text-base shadow-md shadow-sky-600/20 transition-all">
                                Hitung Status BMI
                            </button>
                        </form>
                    </div>

                    <!-- Hasil Perhitungan BMI -->
                    <div id="bmiResultBox" class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-semibold text-slate-600">Skor BMI Kamu:</span>
                            <span id="bmiScoreValue" class="text-2xl font-extrabold text-slate-900">--.-</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-semibold text-slate-600">Kategori Kesehatan:</span>
                            <span id="bmiCategoryBadge" class="px-3 py-1 rounded-full text-xs font-bold bg-slate-200 text-slate-700">
                                Masukkan data di atas
                            </span>
                        </div>
                        <!-- Visual Bar Indikator BMI -->
                        <div class="w-full h-3 rounded-full bg-gradient-to-r from-sky-400 via-emerald-400 via-amber-400 to-rose-500 relative overflow-hidden">
                        </div>
                        <p id="bmiAdviceText" class="text-xs sm:text-sm text-slate-600 leading-relaxed pt-1">
                            Rumus: Berat Badan (kg) ÷ [Tinggi Badan (m)]². Masukkan berat dan tinggi badanmu untuk melihat saran kebugaran.
                        </p>
                    </div>
                </div>

                <!-- KALKULATOR 2: DENYUT NADI MAKSIMAL (DNM) & ZONA LATIHAN -->
                <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-lg shadow-slate-200/50 border border-slate-200/80 flex flex-col justify-between space-y-6">
                    <div class="space-y-5">
                        <div class="flex items-center gap-3.5">
                            <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center">
                                <i data-lucide="heart-pulse" class="w-6 h-6"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-extrabold text-slate-900">Denyut Nadi Maksimal & Zona Latihan</h3>
                                <p class="text-xs sm:text-sm text-slate-500">Panduan intensitas latihan kardiovaskular (DNM = 220 - Usia)</p>
                            </div>
                        </div>

                        <form id="hrForm" class="space-y-4">
                            <div>
                                <label for="usiaSiswa" class="block text-sm font-semibold text-slate-700 mb-1.5">
                                    Usia Saat Ini (Tahun)
                                </label>
                                <input type="number" id="usiaSiswa" min="6" max="90" placeholder="Contoh: 15" required
                                    class="w-full px-4 py-3 rounded-xl border border-slate-300 text-slate-900 font-medium focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            </div>
                            <button type="submit" class="w-full py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm sm:text-base shadow-md shadow-emerald-600/20 transition-all">
                                Hitung Zona Denyut Nadi
                            </button>
                        </form>
                    </div>

                    <!-- Hasil Denyut Nadi -->
                    <div id="hrResultBox" class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
                        <div class="flex items-center justify-between border-b border-slate-200 pb-2.5">
                            <span class="text-sm font-semibold text-slate-600">Denyut Nadi Maksimal (DNM):</span>
                            <span id="dnmValue" class="text-2xl font-extrabold text-rose-600">-- <span class="text-xs font-semibold text-slate-500">bpm</span></span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1">
                            <div class="p-3 rounded-xl bg-sky-50 border border-sky-200/70">
                                <div class="text-[11px] font-bold text-sky-700 uppercase">Pemanasan (50-60%)</div>
                                <div id="zoneLight" class="text-sm font-extrabold text-slate-900 mt-0.5">-- - -- bpm</div>
                                <div class="text-[11px] text-slate-500 mt-0.5">Jalan cepat / jogging ringan</div>
                            </div>
                            <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200/70">
                                <div class="text-[11px] font-bold text-emerald-700 uppercase">Bakar Lemak (60-70%)</div>
                                <div id="zoneModerate" class="text-sm font-extrabold text-slate-900 mt-0.5">-- - -- bpm</div>
                                <div class="text-[11px] text-slate-500 mt-0.5">Lari santai / bersepeda</div>
                            </div>
                            <div class="p-3 rounded-xl bg-orange-50 border border-orange-200/70">
                                <div class="text-[11px] font-bold text-orange-700 uppercase">Kardio / Aerobik (70-85%)</div>
                                <div id="zoneVigorous" class="text-sm font-extrabold text-slate-900 mt-0.5">-- - -- bpm</div>
                                <div class="text-[11px] text-slate-500 mt-0.5">Latihan daya tahan jantung</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- FOOTER -->
    <footer class="bg-slate-900 text-slate-300 py-12 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="flex items-center gap-3">
