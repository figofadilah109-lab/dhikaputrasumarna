                    {
                        nama: '1. Teknik Memegang Bet (Grip)',
                        langkah: [
                            'Shakehand Grip: Memegang bet seperti berjabat tangan; jari telunjuk menempel di bagian belakang bet dan ibu jari di bagian depan.',
                            'Penhold Grip: Memegang bet seperti memegang pena; ibu jari dan telunjuk melingkari gagang bet di sisi depan.'
                        ]
                    },
                    {
                        nama: '2. Pukulan Forehand & Backhand Drive',
                        langkah: [
                            'Forehand Drive: Berdiri menyamping, ayunkan bet dari bawah ke atas depan dengan sudut bet agak tertutup saat bola memantul di titik tertinggi.',
                            'Backhand Drive: Posisikan bet di depan perut, ayunkan bet ke depan atas menggunakan pergelangan tangan dan lengan bawah.'
                        ]
